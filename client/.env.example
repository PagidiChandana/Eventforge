# Copy to .env for local dev, or set as env vars on your host (Vercel/Netlify/Render).
# Vercel frontend + Render backend: set this in Vercel before building, for example:
# VITE_API_URL=https://eventforge-api.onrender.com/api
# Same-origin deploy (for example, nginx proxying /api) can leave it unset.
VITE_API_URL=
# Local dev proxy target (optional, defaults to http://localhost:5000)
VITE_API_PROXY=http://localhost:5000
